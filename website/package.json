{
  "name": "bareship-website",
  "version": "0.0.0",
  "private": true,
  "description": "Website and docs for Bareship (Astro Starlight).",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "node scripts/sync-docs.mjs --dev",
    "build": "node scripts/sync-docs.mjs && astro build && node scripts/check-links.mjs",
    "preview": "astro preview",
    "check": "node scripts/sync-docs.mjs && astro check",
    "check-links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/starlight": "0.42.6",
    "astro": "7.4.7",
    "sharp": "0.35.5"
  }
}
