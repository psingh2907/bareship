APP_ENV=dev
API_URL=https://api.dev.example.com
LOG_LEVEL=debug
API_MOCKS=true
# Deep links (ADR 0010): the app's URL scheme, and a web domain you own for universal links / App Links.
APP_SCHEME=bareshipapp-dev
APP_LINK_DOMAIN=
# iOS push entitlement: development or production. Needs an Apple team; leave empty until then.
IOS_APS_ENVIRONMENT=
# Sign in with Apple and Google (ADR 0020, docs/social-sign-in.md). Empty: no buttons. Client ids are public.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# Needs an Apple team with the capability on the App ID. Run scripts/ios/configure-environments.rb after changing.
IOS_APPLE_SIGN_IN=false
