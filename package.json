{
  "name": "bareship",
  "version": "0.3.2",
  "private": true,
  "description": "Bareship is a production-ready, offline-first bare React Native template for teams and AI agents (Track A).",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">= 22.11.0",
    "pnpm": ">= 11"
  },
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android --mode devDebug --appIdSuffix dev --active-arch-only",
    "android:staging": "react-native run-android --mode stagingDebug --appIdSuffix staging --active-arch-only",
    "android:prod": "react-native run-android --mode prodDebug --active-arch-only",
    "ios": "react-native run-ios --scheme BareshipApp-Dev --mode Debug-Dev",
    "ios:staging": "react-native run-ios --scheme BareshipApp-Staging --mode Debug-Staging",
    "ios:prod": "react-native run-ios --scheme BareshipApp-Prod --mode Debug-Prod",
    "pods": "bundle exec pod install --project-directory=ios",
    "build:android:dev": "cd android && ./gradlew assembleDevRelease",
    "build:android:staging": "cd android && ./gradlew assembleStagingRelease",
    "build:android:prod": "cd android && ./gradlew bundleProdRelease",
    "build:android:demo": "cd android && ./gradlew assembleDevRelease -PdemoBuild -PreactNativeArchitectures=arm64-v8a",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm depcruise && pnpm test",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "icons": "tsx scripts/icons.ts",
    "links:files": "tsx scripts/links-files.ts",
    "gen": "tsx scripts/generate.ts",
    "strip-examples": "tsx scripts/strip-examples.ts",
    "pack-template": "tsx scripts/pack-template.ts",
    "site:dev": "pnpm --dir website dev",
    "site:build": "pnpm --dir website build",
    "skills:sync": "tsx scripts/sync-agent-skills.ts",
    "splash": "tsx scripts/splash.ts generate assets/brand/logo.svg --platforms=android,ios --background=FFFFFF --logo-width=120 --assets-output=assets/bootsplash",
    "prepare": "husky"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "8.13.0",
    "@gorhom/bottom-sheet": "5.2.14",
    "@hookform/resolvers": "5.9.1",
    "@invertase/react-native-apple-authentication": "2.5.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/analytics": "26.4.0",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/crashlytics": "26.4.0",
    "@react-native-firebase/messaging": "26.4.0",
    "@react-native-firebase/remote-config": "26.4.0",
    "@react-native-google-signin/google-signin": "17.0.0",
    "@react-navigation/bottom-tabs": "7.20.0",
    "@react-navigation/elements": "2.9.44",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.20.0",
    "@shopify/flash-list": "2.3.3",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/query-sync-storage-persister": "5.104.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-persist-client": "5.104.1",
    "axios": "1.20.0",
    "i18next": "26.4.2",
    "intl-pluralrules": "2.0.1",
    "lottie-react-native": "7.5.0",
    "lucide-react-native": "1.52.0",
    "react": "19.2.3",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.16",
    "react-native": "0.87.1",
    "react-native-bootsplash": "7.3.4",
    "react-native-config": "1.7.2",
    "react-native-device-info": "15.0.2",
    "react-native-edge-to-edge": "1.8.2",
    "react-native-gesture-handler": "3.3.0",
    "react-native-keyboard-controller": "1.22.6",
    "react-native-keychain": "10.0.0",
    "react-native-localize": "3.7.2",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-notify-kit": "10.8.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-unistyles": "3.5.1",
    "react-native-worklets": "0.13.0",
    "relative-time-format": "1.1.12",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-class-static-block": "7.29.7",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "babel-plugin-module-resolver": "5.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "18.5.0",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "17.6.0",
    "msw": "2.15.0",
    "prettier": "3.9.9",
    "react-native-url-polyfill": "4.0.0",
    "sharp": "0.35.5",
    "test-renderer": "1.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "web-streams-polyfill": "4.3.0"
  }
}
